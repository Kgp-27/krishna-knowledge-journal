---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Search | Krishna's Knowledge Journal"
  description="Search across all published articles in Krishna's Knowledge Journal."
>

  <section class="section search-page">

    <header class="section-header">
      <h1>Search</h1>

      <p class="section-description">
        Search across all published articles.
      </p>
    </header>

    <div class="search-box">
      <label for="search-input">Search articles</label>

      <input
        id="search-input"
        type="search"
        placeholder="Search by title, topic, or keyword..."
        autocomplete="off"
        aria-describedby="search-help"
      />

      <p id="search-help" class="search-help">
        Start typing to search the journal.
      </p>
    </div>

    <div id="search-status" class="search-status" aria-live="polite"></div>

    <div id="search-results" class="article-grid"></div>

  </section>

  <script type="module">
    import MiniSearch from "minisearch";

    const response = await fetch("/search.json");
    const json = await response.json();

    const miniSearch = MiniSearch.loadJS(json, {
      fields: [
        "title",
        "description",
        "category",
        "tags",
        "body",
      ],
      storeFields: [
        "title",
        "description",
        "category",
        "url",
      ],
    });

    const input =
      document.getElementById("search-input");

    const results =
      document.getElementById("search-results");

    const status =
      document.getElementById("search-status");

    input?.addEventListener("input", () => {

      const query = input.value.trim();

      if (!query) {
        results.innerHTML = "";
        status.textContent = "";
        return;
      }

      const matches = miniSearch.search(query);

      status.textContent =
        matches.length === 1
          ? "1 article found"
          : `${matches.length} articles found`;

      results.innerHTML = matches.length
        ? matches.map(result => `
            <article class="article-card">

              <header>
                <h3>
                  <a href="${result.url}">
                    ${result.title}
                  </a>
                </h3>

                <p class="article-meta">
                  ${result.category}
                </p>
              </header>

              <p>
                ${result.description}
              </p>

            </article>
          `).join("")
        : `
            <div class="search-empty">
              <h2>No matching articles found</h2>
              <p>
                Try a different keyword, topic, or article title.
              </p>
            </div>
          `;

    });
  </script>

</BaseLayout>