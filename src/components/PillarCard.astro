---
interface Props {
  title: string;
  description: string;
  href?: string;
}

const { title, description, href } = Astro.props;
---

{
  href ? (
    <a class="pillar-card" href={href}>
      <header>
        <h3>{title}</h3>
      </header>
      <p>{description}</p>
    </a>
  ) : (
    <article class="pillar-card">
      <header>
        <h3>{title}</h3>
      </header>
      <p>{description}</p>
    </article>
  )
}