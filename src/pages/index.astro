---
import { parse } from 'yaml';
import homepageConfigText from '../content/homepage/config.yml?raw';

import {
  getHomepageHero,
  getLatestArticles,
  getPublishedArticles,
} from '../lib/articles';

import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import PillarCard from '../components/PillarCard.astro';

const homepageConfig = parse(homepageConfigText);

const featuredArticle = await getHomepageHero();
const latestArticles = await getLatestArticles();
const publishedArticles = await getPublishedArticles();

function normalizeReference(value: unknown): string {
  if (typeof value !== 'string') return '';

  return value
    .replace(/\\/g, '/')
    .replace(/^.*\/content\/articles\//, '')
    .replace(/^.*\/articles\//, '')
    .replace(/\.md$/, '')
    .replace(/^\/+|\/+$/g, '')
    .trim()
    .toLowerCase();
}

function resolveArticle(reference: unknown) {
  const values =
    typeof reference === 'string'
      ? [reference]
      : reference && typeof reference === 'object'
        ? [
            (reference as any).path,
            (reference as any).value,
            (reference as any).id,
            (reference as any).slug,
            (reference as any).title,
            (reference as any).label,
          ]
        : [];

  const references = values
    .filter((value): value is string => typeof value === 'string')
    .map(normalizeReference)
    .filter(Boolean);

  return publishedArticles.find((article) => {
    const id = normalizeReference(article.id);
    const title = normalizeReference(article.data.title);

    return references.some(
      (reference) =>
        reference === id ||
        reference.endsWith(`/${id}`) ||
        id.endsWith(`/${reference}`) ||
        reference === title
    );
  });
}

const visibleSeries = (homepageConfig.collections ?? [])
  .filter((collection: any) => collection.visible)
  .map((collection: any) => ({
    ...collection,
    articles: (collection.articles ?? [])
      .map(resolveArticle)
      .filter((article: any) => article !== undefined),
  }))
  .filter((collection: any) => collection.articles.length > 0);

const featuredSeries = visibleSeries[0];
const allSeries = visibleSeries.slice(1);

const subjectDescriptions: Record<string, string> = {
  Finance: 'Money, investing, corporate finance and financial markets.',
  Economics: 'Microeconomics, macroeconomics and economic thought.',
  'Indian Banking':
    'The Reserve Bank of India, commercial banking, regulation and monetary systems.',
  Taxation: 'Direct taxation, indirect taxation and public finance.',
  History: 'Economic history, financial history and institutional development.',
};
---

<BaseLayout
  title="Krishna's Knowledge Journal"
  description="Finance, Economics, Indian Banking, Taxation and History explained from first principles."
>
  <Hero />

  {featuredArticle && (
    <Section
      title="Featured Article"
      description="Editor's featured publication."
    >
      <div class="featured-article-card">
        <ArticleCard article={featuredArticle} />
      </div>
    </Section>
  )}

  <Section
    title="Explore the Library"
    description="Explore the five permanent disciplines that form the foundation of Krishna's Knowledge Journal."
  >
    <div class="pillar-grid">
      {homepageConfig.subjectLinks.map((subject: any) => (
        <PillarCard
          title={subject.title}
          description={
            subjectDescriptions[subject.title] ??
            `Explore articles about ${subject.title}.`
          }
          href={subject.href}
        />
      ))}
    </div>
  </Section>

  {featuredSeries && (
    <Section
      title="Featured Series"
      description={featuredSeries.description ?? ''}
    >
      <div class="pillar-grid">
        {featuredSeries.articles.map((article: any) => (
          <ArticleCard article={article} />
        ))}
      </div>
    </Section>
  )}

  {allSeries.length > 0 && (
    <Section
      title="All Series"
      description="Explore the other curated article series."
    >
      {allSeries.map((series: any) => (
        <div class="series-group">
          <h3>{series.title}</h3>
          {series.description && <p>{series.description}</p>}
          <div class="pillar-grid">
            {series.articles.map((article: any) => (
              <ArticleCard article={article} />
            ))}
          </div>
        </div>
      ))}
    </Section>
  )}

  <Section
    title="Latest Articles"
    description="The latest publications from Krishna's Knowledge Journal."
  >
    {latestArticles.length > 0 ? (
      <div class="pillar-grid">
        {latestArticles.map((article) => (
          <ArticleCard article={article} />
        ))}
      </div>
    ) : (
      <p>No articles have been published yet.</p>
    )}
  </Section>
</BaseLayout>
